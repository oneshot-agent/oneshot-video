# OneShot agent wallet key (same name the SDK and oneshot-gtm use). The script stage reads the app with agent.webRead() — a paid call with a signed receipt.
AGENT_PRIVATE_KEY=
# Intake page (apps/intake): admin view key and port. PUBLIC_URL is where people reach it; every
# entry point (form, MCP, CLI) hands back ${PUBLIC_URL}/r/<id>.
PUBLIC_URL=http://localhost:3034
INTAKE_ADMIN_KEY=
INTAKE_PORT=3034
# Narration. eleven_v3, voice Sarah, settings are fixed in @oneshot-agent/video-baseline/voice.
ELEVENLABS_API_KEY=
# Script writing. Any OpenRouter model; the prompt is in packages/script/prompts/script.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Repo boot. OneShot's E2B compute template (packages/explore/src/boot.ts, E2B_TEMPLATE).
E2B_API_KEY=
