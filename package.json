{
  "name": "oneshot-video-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The launch-film wrapper over OneShot. A URL in, a 30-second product video out, voiced and silent. The taste is a package.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "latest",
      "typescript": "^6.0.3",
      "vitest": "^4.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "cli": "bun run apps/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "studio": "bun run --cwd packages/film studio",
    "render": "bun run --cwd packages/film render",
    "intake:serve": "bun run apps/intake/src/server.ts",
    "intake:next": "bun run apps/intake/src/next.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.55.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.13"
}
